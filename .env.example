# ── LLM provider ──────────────────────────────────────────────────────────────
# Choose the LLM backend: "gemini" (default) or "groq"
LLM_PROVIDER=gemini

# Gemini (required if LLM_PROVIDER=gemini) — get a key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash          # optional override; default is gemini-2.0-flash

# Groq (required if LLM_PROVIDER=groq) — get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile     # optional override

# ── SEC EDGAR (required for ingest/fetch_filings.py) ──────────────────────────
SEC_USER_AGENT=YourName your@email.com

# ── Langfuse tracing (optional) ───────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── API behaviour ─────────────────────────────────────────────────────────────
DEMO_MODE=false
RATE_LIMIT_RPM=30
FAITH_GATE=0.60

# Low-memory mode: skip sentence-transformers/CrossEncoder, use BM25-only retrieval.
# Set to true on memory-constrained hosts (e.g. free-tier PaaS with <512MB RAM).
LOW_MEMORY=false
